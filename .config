# ============================================================
# 官方 OpenWrt 24.10 版 .config —— 整体替换仓库里的 .config
# 保存后推送到 GitHub，工作流会执行 make defconfig 自动补全其余默认项
# ============================================================

# ---- 目标：MediaTek / Filogic / Cudy TR3000 256MB v1 ----
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3000-256mb-v1=y

# ---- LuCI（官方 defconfig 不保证默认带，显式开启）----
CONFIG_PACKAGE_luci=y

# ---- Design 主题 + 设置页（由 diy-part1.sh 引入的 feed 提供）----
CONFIG_PACKAGE_luci-theme-design=y
CONFIG_PACKAGE_luci-app-design-config=y

# ---- OpenClash（feed 引入；依赖 dnsmasq-full，需要换掉默认 dnsmasq）----
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# ---- UA2F（feed 引入；内核选项由 diy-part2.sh 开启）----
CONFIG_PACKAGE_ua2f=y

# ---- UA2F 网页配置界面（luci-app-ua2f，菜单：服务->防检测；diy-part1.sh 引入）----
CONFIG_PACKAGE_luci-app-ua2f=y
# lua 旧式应用在 24.10 靠 luci-compat 渲染（design-config 同款，保险起见显式开启）
CONFIG_PACKAGE_luci-compat=y

# ---- USB 随身上网卡（RNDIS / CDC-ECM / MBIM / QMI + 模式切换）----
# 注：TR3000 256MB 机型默认设备包已带 kmod-usb3，这里补上网卡相关
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_usb-modeswitch=y
# CDC-NCM：大量随身WiFi/4G棒子用这种协议（华为中兴等），补上更稳
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y

# ---- WAN / USB 主备切换（mwan3）----
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# ---- 其他个人项（官方源里同样存在）----
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_kmod-sched-cake=y
# UPnP 不需要，不编
CONFIG_PACKAGE_luci-app-wol=y

# ---- 简体中文语言包（刷机即中文，无需再手动联网安装）----
# 24.10 翻译目录为 zh_Hans，打包名统一为 *-zh-cn
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
